# NavIC frontend environment template
#
# Vite exposes only variables prefixed with VITE_ to the browser. Copy this
# file to frontend/.env (or .env.local) when overriding a default.

# API calls use relative URLs. The project-root BACKEND_URL controls the Vite
# development proxy, whose default target is http://localhost:8000.

# development | production. Development enables verbose diagnostics in the UI.
VITE_APP_ENV=development

# Optional map tile overrides. Defaults use OpenStreetMap.
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
# VITE_MAP_SATELLITE_URL=
